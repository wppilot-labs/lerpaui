{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegistryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["registry:ui", "registry:block"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["registry:page", "registry:component", "registry:ui", "registry:hook", "registry:theme", "registry:file"]
          }
        },
        "required": ["path", "content", "type"]
      }
    },
    "cssVars": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": ["name", "type", "files"]
}
