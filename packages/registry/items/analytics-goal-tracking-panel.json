      "content": "\"use client\";\n\nimport React, { useState } from \"react\";\nimport { TrendingUp } from \"lucide-react\";\n\nexport function AnalyticsGoalTrackingPanel() {\n  const [value, setValue] = useState(42000);\n\n  return (\n    <div className=\"w-full max-w-sm bg-card/45 backdrop-blur-xl border border-border/50 p-5 rounded-2xl shadow-xl select-none font-sans text-foreground\">\n      <div className=\"flex items-center justify-between mb-4\">\n        <div className=\"flex items-center gap-1.5\">\n          <TrendingUp className=\"w-4 h-4 text-violet-400\" />\n          <span className=\"text-xs font-bold uppercase tracking-wider text-muted-foreground\">Goal: MRR Target</span>\n        </div>\n        <span className=\"text-[9px] uppercase font-bold text-violet-400\">$50,000 Goal</span>\n      </div>\n\n      <div className=\"space-y-4\">\n        <div>\n          <div className=\"flex justify-between text-xs mb-1.5\">\n            <span className=\"text-muted-foreground/60\">Goal Progress</span>\n            <span className=\"font-bold text-violet-400\">{((value / 50000) * 100).toFixed(0)}%</span>\n          </div>\n          <div className=\"h-2 bg-secondary/40 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-gradient-to-r from-violet-500 to-indigo-500 rounded-full\" style={{ width: `${(value / 50000) * 100}%` }} />\n          </div>\n        </div>\n\n        <div className=\"flex justify-between text-[10px] text-muted-foreground\">\n          <span>Current: <span className=\"font-bold text-foreground\">${value.toLocaleString()}</span></span>\n          <span>Remaining: <span className=\"font-bold text-foreground\">$8,000</span></span>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
  ]
