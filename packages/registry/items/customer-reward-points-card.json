      "content": "\"use client\";\n\nimport React, { useState } from \"react\";\nimport { Award, Gift } from \"lucide-react\";\n\nexport function CustomerRewardPointsCard() {\n  const [points, setPoints] = useState(850);\n\n  return (\n    <div className=\"w-full max-w-sm bg-card/45 backdrop-blur-xl border border-border/50 p-5 rounded-2xl shadow-xl select-none font-sans text-foreground\">\n      <div className=\"flex items-center justify-between mb-4\">\n        <div className=\"flex items-center gap-1.5\">\n          <Award className=\"w-4 h-4 text-violet-400\" />\n          <span className=\"text-xs font-bold uppercase tracking-wider text-muted-foreground\">Reward Milestones</span>\n        </div>\n        <span className=\"text-[9px] uppercase font-bold text-violet-400 bg-violet-500/10 px-2 py-0.5 rounded border border-violet-500/20\">Gold Loyalty Tier</span>\n      </div>\n\n      <div className=\"space-y-4\">\n        <div>\n          <div className=\"flex justify-between text-xs mb-1.5\">\n            <span className=\"text-muted-foreground/60\">Milestone: VIP Voucher</span>\n            <span className=\"font-bold text-violet-400\">{points} / 1,000 PTS</span>\n          </div>\n          <div className=\"h-1.5 bg-secondary/40 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-violet-500\" style={{ width: `${(points / 1000) * 100}%` }} />\n          </div>\n        </div>\n\n        <div className=\"p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.03] flex items-center justify-between text-xs\">\n          <span className=\"text-muted-foreground/75 flex items-center gap-1.5\"><Gift className=\"w-4 h-4 text-violet-400 animate-pulse\" /> Claim $15.00 Coupon Code</span>\n          <button \n            disabled={points < 1000}\n            className=\"text-[9px] uppercase font-bold text-violet-400 disabled:opacity-40 disabled:text-muted-foreground\"\n          >\n            Redeem\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
