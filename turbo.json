{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "@lerpa/registry#build": {
      "outputs": ["generated/**"]
    },
    "lerpa-cli#build": {
      "dependsOn": ["@lerpa/registry#build"],
      "outputs": ["dist/**", "registry/**"]
    },
    "@lerpa/mcp-server#build": {
      "dependsOn": ["@lerpa/registry#build"],
      "outputs": ["dist/**", "registry/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "lerpa-cli#test": {
      "dependsOn": ["build"]
    },
    "@lerpa/mcp-server#test": {
      "dependsOn": ["build"]
    }
  }
}
